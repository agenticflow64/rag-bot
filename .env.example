# --- Генерация (LLM-провайдеры) ---
# GLM (основной, OpenAI-совместимый): https://open.bigmodel.cn
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_CHAT_MODEL=glm-5.3-flash

# OpenRouter (резерв, если GLM недоступен): https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Провайдер генерации: auto (основной с откатом на резерв) | glm | openrouter
CHAT_PROVIDER=auto

# --- Эмбеддинги ---
# local: на GPU через sentence-transformers (bge-m3), без внешних API
# glm | openrouter: через API-провайдера (тогда EMBEDDING_DIM=1536)
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_DEVICE=cuda
EMBEDDING_DIM=1024

# --- БД ---
DATABASE_URL=postgres://rag:rag@localhost:5432/rag

# --- Retrieval / чанкинг ---
TOP_K=5
RELEVANCE_THRESHOLD=0.45
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# --- Веб ---
# PORT=8800
